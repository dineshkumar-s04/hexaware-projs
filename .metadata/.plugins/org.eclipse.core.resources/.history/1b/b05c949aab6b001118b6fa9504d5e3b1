	@Override
	public PatientInsurance addInsurance(PatientInsuranceDTO patientInsuranceDTO) {

		PatientInsurance patientInsurance = new PatientInsurance();

		patientInsurance.setInsuranceId(patientInsuranceDTO.getInsuranceId());
		patientInsurance.setInsuranceName(patientInsuranceDTO.getInsuranceName());
		patientInsurance.setPatientName(patientInsuranceDTO.getPatientName());

		return repo.save(patientInsurance);
	}

	@Override
	public PatientInsuranceDTO getById(int insuranceId) {

		PatientInsurance patientInsurance = repo.findById(insuranceId).orElse(null);

		PatientInsuranceDTO dto = new PatientInsuranceDTO();
		dto.setInsuranceId(patientInsurance.getInsuranceId());
		dto.setInsuranceName(patientInsurance.getInsuranceName());
		dto.setPatientName(patientInsurance.getPatientName());

		return dto;
	}

