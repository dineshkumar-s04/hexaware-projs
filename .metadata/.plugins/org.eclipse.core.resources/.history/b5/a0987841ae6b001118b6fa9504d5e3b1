package com.hexaware.patientinsurance.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.client.RestTemplate;

import com.hexaware.patientinsurance.dto.Patient;
import com.hexaware.patientinsurance.dto.PatientInsuranceDTO;
import com.hexaware.patientinsurance.dto.PatientPatientInsuranceVO;
import com.hexaware.patientinsurance.entity.PatientInsurance;
import com.hexaware.patientinsurance.repository.PatientInsuranceRepository;

public class PatientInsuranceServiceImp implements IPatientInsuranceService {

	@Autowired
	PatientInsuranceRepository repo;

	@Autowired
	RestTemplate restTemplate;

	@Override
	public PatientInsurance addInsurance(PatientInsuranceDTO patientInsuranceDTO) {

		PatientInsurance patientInsurance = new PatientInsurance();

		patientInsurance.setInsuranceId(patientInsuranceDTO.getInsuranceId());
		patientInsurance.setInsuranceName(patientInsuranceDTO.getInsuranceName());
		patientInsurance.setPatientId(patientInsuranceDTO.getPatientId());

		return repo.save(patientInsurance);
	}

	@Override
	public PatientInsuranceDTO getById(int insuranceId) {

		PatientInsurance patientInsurance = repo.findById(insuranceId).orElse(null);

		PatientInsuranceDTO dto = new PatientInsuranceDTO();
		dto.setInsuranceId(patientInsurance.getInsuranceId());
		dto.setInsuranceName(patientInsurance.getInsuranceName());
		dto.setPatientId(patientInsurance.getPatientId());

		return dto;
	}

	@Override
	public List<PatientInsurance> getAllInsurance() {

		return repo.findAll();
	}

	@Override
	public void updatePatientByInsurance(Patient patient) {
		
		restTemplate.put("http://localhost:8181/api/patients/update", patient);
		System.out.println("updated patient from insurance MS " );
	}

	@Override
	public PatientPatientInsuranceVO getPatientAndInsurance(int insuranceId) {


		PatientInsuranceDTO patient = getById(insuranceId);
		
		int pid = patient.getPatientId();
		
		Patient patient = restTemplate.getForObject("http://localhost:8181/api/patients/get"+pid, Patient.class)
		
		return null;
	}

}
